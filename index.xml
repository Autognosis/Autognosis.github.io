&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;[(&lt;span style="color:#5af78e"&gt;&amp;#39;a&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;1&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;b&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;2&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;c&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;3&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;d&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;4&lt;/span&gt;)]
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#ff6ac1"&gt;&amp;gt;&amp;gt;&amp;gt;&lt;/span&gt; &lt;span style="color:#ff5c57"&gt;sorted&lt;/span&gt;(L, key&lt;span style="color:#ff6ac1"&gt;=&lt;/span&gt;&lt;span style="color:#ff6ac1"&gt;lambda&lt;/span&gt; x:x[&lt;span style="color:#ff9f43"&gt;1&lt;/span&gt;]) &lt;span style="color:#78787e"&gt;# 利用key&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;[(&lt;span style="color:#5af78e"&gt;&amp;#39;a&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;1&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;b&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;2&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;c&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;3&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;d&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;4&lt;/span&gt;)]
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; 
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; 
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#ff6ac1"&gt;&amp;gt;&amp;gt;&amp;gt;&lt;/span&gt; students &lt;span style="color:#ff6ac1"&gt;=&lt;/span&gt; [(&lt;span style="color:#5af78e"&gt;&amp;#39;john&amp;#39;&lt;/span&gt;, &lt;span style="color:#5af78e"&gt;&amp;#39;A&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;15&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;jane&amp;#39;&lt;/span&gt;, &lt;span style="color:#5af78e"&gt;&amp;#39;B&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;12&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;dave&amp;#39;&lt;/span&gt;, &lt;span style="color:#5af78e"&gt;&amp;#39;B&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;10&lt;/span&gt;)]
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#ff6ac1"&gt;&amp;gt;&amp;gt;&amp;gt;&lt;/span&gt; &lt;span style="color:#ff5c57"&gt;sorted&lt;/span&gt;(students, key&lt;span style="color:#ff6ac1"&gt;=&lt;/span&gt;&lt;span style="color:#ff6ac1"&gt;lambda&lt;/span&gt; s: s[&lt;span style="color:#ff9f43"&gt;2&lt;/span&gt;]) &lt;span style="color:#78787e"&gt;# 按年龄排序&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;[(&lt;span style="color:#5af78e"&gt;&amp;#39;dave&amp;#39;&lt;/span&gt;, &lt;span style="color:#5af78e"&gt;&amp;#39;B&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;10&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;jane&amp;#39;&lt;/span&gt;, &lt;span style="color:#5af78e"&gt;&amp;#39;B&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;12&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;john&amp;#39;&lt;/span&gt;, &lt;span style="color:#5af78e"&gt;&amp;#39;A&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;15&lt;/span&gt;)]
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; 
