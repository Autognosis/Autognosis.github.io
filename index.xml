&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;[(&lt;span style="color:#5af78e"&gt;&amp;#39;john&amp;#39;&lt;/span&gt;, &lt;span style="color:#5af78e"&gt;&amp;#39;A&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;15&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;jane&amp;#39;&lt;/span&gt;, &lt;span style="color:#5af78e"&gt;&amp;#39;B&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;12&lt;/span&gt;), (&lt;span style="color:#5af78e"&gt;&amp;#39;dave&amp;#39;&lt;/span&gt;, &lt;span style="color:#5af78e"&gt;&amp;#39;B&amp;#39;&lt;/span&gt;, &lt;span style="color:#ff9f43"&gt;10&lt;/span&gt;)]
